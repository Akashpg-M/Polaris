# Copy to .env or run start.ps1, which creates a local file with secure random
# values. Do not commit the generated .env file.
APP_ENV=production
LOG_LEVEL=info

POSTGRES_USER=polaris_user
POSTGRES_DB=polaris_core
POSTGRES_PASSWORD=replace_with_a_url_safe_random_secret
DEV_PLATFORM_ADMIN_TOKEN=pol_op_replace_with_a_secure_random_secret

# The browser-facing frontend is public. Direct service and infrastructure
# ports default to loopback and are intended for diagnostics only.
PUBLIC_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5173
SERVICE_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=6080
ENGINE_PORT=6081
INFRA_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644

GATEWAY_ID=gateway-1
CONNECTION_LEASE_TTL=30s
COMMAND_RECONCILE_INTERVAL=1s
COMMAND_ACK_TIMEOUT=5s
COMMAND_MAX_ATTEMPTS=5
DEVICE_STALE_AFTER=30s
DEVICE_OFFLINE_AFTER=90s
OFFLINE_SCAN_INTERVAL=10s
CONNECTION_TICKET_TTL=30s
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=500ms

POLARIS_MODULE_MOBILITY_ENABLED=true
POLARIS_MODULE_MOBILITY_REQUIRED=false
MOBILITY_SPATIAL_ENABLED=true
MOBILITY_ROUTING_ENABLED=true
MOBILITY_ROAD_GRAPH_PATH=data/chennai-metro.osm.pbf
MOBILITY_ROAD_GRAPH_VERSION=chennai-v1

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
